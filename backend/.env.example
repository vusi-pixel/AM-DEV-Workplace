# AM DEV Pro Workplace — Backend Environment Example
# Copy this to .env and fill in real values.
# NEVER commit the .env file.

# ─── Database ────────────────────────────────────────────────────────────────
# For Docker Compose: use the values from docker-compose.yml
DATABASE_URL="postgresql://amdev:amdev_dev_password@localhost:5432/amdev_workplace?schema=public"

# ─── Session ─────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_HEX_STRING"
SESSION_MAX_AGE_MS=28800000   # 8 hours

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ─── Application timezone ─────────────────────────────────────────────────────
TZ=UTC

# ─── Cookie security ──────────────────────────────────────────────────────────
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
